# Third-party agent skills are a cache, not source. `skills-lock.json` IS
# tracked; downloaded files are restored from it, like node_modules from a
# lockfile. Skills we write ourselves get re-included here by name.
.claude/skills/*
.agents/
.claude/settings.local.json
.claude/projects/

# Per-developer editor and agent config
.codex/
.opencode/
.zed/
.idea/
.vscode/
*.swp
*.swo

# Dependencies and build output
node_modules/
dist/
.astro/
.wrangler/
worker-configuration.d.ts

# Secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Raw analytics and interview material: may hold personal data
docs/research/raw/

.DS_Store
*.log

# Ship state: `.ship/published` is committed, the rest stays on this machine
.ship/lock
.ship/preview-url
.ship/published.tmp
.ship/snapshots/
.ship/reports/
.ship/baseline

# Generated from the snapshot at build
src/generated/
public/img/
public/reader.js
.ship/images/
.ship/segments/

# Private records: production weaknesses, keys' whereabouts, traffic figures,
# agent spend and private tooling. They stay on the owner's machine (AGENTS.md).
docs/site-plan.md
docs/decisions/2026-10-31-agent-setup-test.md
docs/decisions/2026-10-31-content-write-fix.md
docs/decisions/2026-10-31-live-site-fix.md
docs/decisions/2026-10-31-migration-run-sheet.md
docs/research/agent-files.md
docs/research/claims-audit.md
docs/research/current-site.md
docs/research/setup-review.md
docs/research/skills.md
scripts/owner/
# The spike's throwaway templates, already ported; their tests name a private host.
vendor/spike/
