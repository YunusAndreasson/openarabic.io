{
  // NOT "openarabic-web". That is the Worker serving the live openarabic.io and
  // its admin panel, and it shares this folder's name. The Astro adapter names a
  // Worker after the package or folder when no config sets one, so this file
  // must exist and must keep this name, or a deploy could overwrite the live site.
  "name": "openarabic-site",

  // No newer than the installed workerd supports, or `astro dev` won't start.
  "compatibility_date": "2026-10-23",

  // AGENTS.md `Prerender or on-demand`: only what a file can't answer. Prerendered pages never run this.
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    // Assets alone answer a trailing slash with a 307 and ignore the query.
    "run_worker_first": ["/", "/download-app", "/dictionary/search", "/v", "/_astro/*.mp3", "/word/*/", "/read/*/", "/author/*/", "/category/*/", "/dictionary/*/", "/books/*/"]
  },

  // Page views and store taps: page type, event and day only. docs/decisions/2026-11-01-counters.md.
  "analytics_engine_datasets": [{ "binding": "COUNTS", "dataset": "openarabic_site_counts" }],

  // The owner's go, 2026-11-02. Must stay here: a deploy without it could detach the domain. Under `pnpm ship --production` only.
  "routes": [{ "pattern": "openarabic.io", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
