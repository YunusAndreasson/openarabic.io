{
  // NOT "openarabic-web". That is the Worker serving the live openarabic.io and
  // its admin panel, and it shares this folder's name. The Astro adapter names a
  // Worker after the package or folder when no config sets one, so this file
  // must exist and must keep this name, or a deploy could overwrite the live site.
  "name": "openarabic-site",

  // No newer than the installed workerd supports, or `astro dev` won't start.
  "compatibility_date": "2026-10-23",

  // No routes and no custom domains until the cutover in docs/site-plan.md.
  "workers_dev": true,
  "preview_urls": false
}
