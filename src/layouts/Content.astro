---
// DESIGN.md `Content surfaces`: opens on its content, one offer, a top line that isn't sticky.
import Base from './Base.astro';
import '../styles/content.css';

const { crumbs = [], ...base } = Astro.props;
---

<Base {...base}>
  <header class="top">
    <a class="top-name" href="/"><svg viewBox="0 0 1000 1000" width="22" height="22" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M0 500a500 500 0 1 1 1000 0a500 500 0 1 1-1000 0ZM106.9 500a393.1 393.1 0 1 0 786.2 0a393.1 393.1 0 1 0-786.2 0Z" /></svg><span>OpenArabic</span></a>{' '}
    {base.canonical !== '/download-app' && <a class="top-app" href="/download-app">Get the app</a>}
  </header>
  <main class="content">
    {crumbs.length > 0 && (
      <nav class="crumbs quiet" aria-label="Breadcrumb">
        {crumbs.map((crumb: { name: string; path?: string }, index: number) => (
          <>{index > 0 && ' / '}{crumb.path ? <a href={crumb.path}>{crumb.name}</a> : <span data-stored>{crumb.name}</span>}</>
        ))}
      </nav>
    )}
    <slot />
  </main>
</Base>
