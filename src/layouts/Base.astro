---
import '../styles/tokens.generated.css';
import '../styles/fonts.css';
import '../styles/base.css';
import { themeColorHex } from '../styles/tokens.generated';
import amiriUrl from '../fonts/amiri-regular.subset.woff2?url';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OpenArabic: Read the Classics',
  description = 'If you can sound out Arabic script, you can start reading classical texts.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColorHex} />
    <link rel="icon" href="data:," />
    <link rel="preload" href={amiriUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
