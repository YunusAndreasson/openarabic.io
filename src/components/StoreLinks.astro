---
// Official badges, unmodified. `from` is the surface, never a word or slug: the Worker drops any other.
interface Props {
  from?: 'home' | 'try' | 'close' | 'word' | 'read' | 'book' | 'download';
}
const { from = 'home' } = Astro.props;
---

<div class="stores"><a class="badge" href={`/download-app?to=ios&from=${from}`}><img src="/badge-app-store.svg" width="144" height="48" alt="Download on the App Store" /></a>{' '}<a class="badge" href={`/download-app?to=android&from=${from}`}><img src="/badge-google-play.png" width="162" height="48" alt="Get it on Google Play" /></a></div>
