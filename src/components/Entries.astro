---
// A list of dictionary entries. Arabic exactly as stored.
import { wordSlug } from '../lib/words.mjs';
const { entries } = Astro.props;
---

<ul class="entries">
  {entries.map((entry: any) => <li><a href={entry.path ?? `/word/${wordSlug(entry)}`}><span class="entry-ar" lang="ar" dir="rtl">{entry.letters}</span> <span data-stored>{entry.meaning}</span></a></li>)}
</ul>
