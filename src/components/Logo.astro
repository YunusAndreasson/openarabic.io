  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg viewBox="0 0 1000 1000" width={size} height={size} aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M0 500a500 500 0 1 1 1000 0a500 500 0 1 1-1000 0ZM106.9 500a393.1 393.1 0 1 0 786.2 0a393.1 393.1 0 1 0-786.2 0Z" /></svg>
