---
// A plain GET form with no script. The Worker answers it.
---

<form class="search" action="/dictionary/search" method="get" role="search">
  <label class="vh" for="q">Search the dictionary</label>
  <input id="q" name="q" type="search" value="" maxlength="60" placeholder="A meaning or an Arabic word" autocomplete="off" />
  <button type="submit">Search</button>
</form>
