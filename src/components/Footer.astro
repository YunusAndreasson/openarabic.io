---
import { CATEGORIES } from '../lib/words.mjs';
import scholars from '../data/footer-scholars.json';
---

<footer>
  <div class="footer-inner">
    <a class="footer-brand" href="/"><svg viewBox="0 0 1000 1000" width="22" height="22" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M0 500a500 500 0 1 1 1000 0a500 500 0 1 1-1000 0ZM106.9 500a393.1 393.1 0 1 0 786.2 0a393.1 393.1 0 1 0-786.2 0Z" /></svg><span>OpenArabic</span></a>
    <nav class="footer-browse" aria-label="Browse">
      <p class="footer-links"><a href="/dictionary">Dictionary</a>{' '}<a href="/books/al-fawaid">Al-Fawāʾid</a>{' '}{Object.entries(CATEGORIES).map(([name, label]) => <><a href={`/category/${name}`}>{label}</a>{' '}</>)}</p>
      <p class="footer-links">{scholars.map((scholar) => <><a href={scholar.path}>{scholar.name}</a>{' '}</>)}</p>
    </nav>
    <div class="footer-legal">
      <p class="footer-links"><a href="/privacy">Privacy</a>{' '}<a href="/terms">Terms</a>{' '}<a href="/contact">Contact</a>{' '}<a href="/account-deletion">Account deletion</a>{' '}<a href="/analytics-choice">Analytics choice</a></p>
      <p class="quiet credits">Amiri and Inter are used under the SIL Open Font License. App Store is a trademark of Apple Inc. Google Play is a trademark of Google LLC.</p>
    </div>
  </div>
</footer>
