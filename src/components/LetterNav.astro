---
import { site } from '../lib/snapshot.mjs';
import { bucketLabel } from '../lib/words.mjs';

interface Props {
  /** The letter whose page this is, if any. */
  active?: string;
}
const { active } = Astro.props;
---

<ul class="letters">
  {site().letters().map((bucket) => <li><a href={`/dictionary/${bucket}`} aria-current={bucket === active ? 'page' : undefined}>{bucketLabel(bucket)}</a></li>)}
</ul>
