---
// DESIGN.md `Capture`: flat and whole, status bar kept, resized from the 1080x2400 original.
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---

<figure class="capture object"><img src={src} width="720" height="1600" decoding="async" loading="lazy" alt={alt} /><figcaption><slot /></figcaption></figure>
