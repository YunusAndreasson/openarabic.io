---
// Article cards, hardest last. Text as stored. Images are served from the build.
import { articlePath, levelName } from '../lib/words.mjs';
import { imageOf } from '../lib/images.mjs';

interface Article {
  id: number;
  title: string;
  book: string | null;
  image_url: string | null;
  difficulty_level: number;
  author_id: number;
}
interface Props {
  articles: Article[];
  /** The line under each title. The work it is from, unless this names the scholar instead. */
  authorOf?: (article: Article) => string;
}
const { articles, authorOf } = Astro.props;
---

<ul class="cards">
  {articles.map((article) => {
    const image = imageOf(article.image_url);
    return (
      <li class="card">
        <a href={articlePath(article)}>
          {image && <img src={image.src(480)} width={480} height={Math.round((480 * image.height) / image.width)} alt="" loading="lazy" decoding="async" />}
          <span class="card-title" data-stored>{article.title}</span>
        </a>
        <p class="quiet meta"><span data-stored>{authorOf ? authorOf(article) : article.book}</span> <span class="level">{levelName(article.difficulty_level)}</span></p>
      </li>
    );
  })}
</ul>
