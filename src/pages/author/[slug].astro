---
import type { GetStaticPaths } from 'astro';
import Content from '../../layouts/Content.astro';
import ArticleList from '../../components/ArticleList.astro';
import Offer from '../../components/Offer.astro';
import { site } from '../../lib/snapshot.mjs';
import { absolute, itemList } from '../../lib/site.mjs';
import { authorPath, authorSlug, difficultyLine, shownName } from '../../lib/words.mjs';

export const getStaticPaths = (() => site().authorsWithTexts().map((author) => ({ params: { slug: authorSlug(author) }, props: { author } }))) satisfies GetStaticPaths;

const { author } = Astro.props;
const articles = site().byDifficulty(site().articlesBy(author.id));
const works = [...new Set(articles.map((article) => article.book).filter(Boolean))];
const path = authorPath(author);
const jsonLd = [
  { '@type': 'ProfilePage', name: author.name, url: absolute(path), mainEntity: { '@type': 'Person', name: author.name } },
  itemList(articles),
];
---

<Content title={`Texts by ${author.name} | OpenArabic`} description={`Excerpts from classical works by ${author.name}, in Arabic with English under every line.`} canonical={path} jsonLd={jsonLd} ogType="profile">
  <h1 data-stored>{shownName(author.name)}</h1>
  <p class="lead">Excerpts from <span data-stored>{works.join(', ')}</span>.</p>
  <p>{difficultyLine(articles)}</p>
  <ArticleList articles={articles} />
  <Offer from="read" screen="read" />
</Content>
