---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Stage from '../components/Stage.astro';
import Still from '../components/Still.astro';
import StillPair from '../components/StillPair.astro';
import ArticleWall from '../components/ArticleWall.astro';
import TappableLine from '../components/TappableLine.astro';
import StoreQr from '../components/StoreQr.astro';
import StoreLinks from '../components/StoreLinks.astro';
import line from '../data/story-line.json';
// A whole text as the app plays it in Arabic: article 412's stored audio_url, copied so the player's length costs no third-party request.
import textAudio from '../assets/story/text-412-arabic.mp3?url';
import scholarData from '../data/scholars.json';
import footerScholars from '../data/footer-scholars.json';
import startPath from '../data/start-path.json';
import { articlePath } from '../lib/words.mjs';
import '../styles/story.css';
import '../styles/home.css';

// Each scholar links to their page. The footer's list holds the paths; a name missing there is a mistake, not a quiet gap.
const pathOf = new Map(footerScholars.map((scholar) => [scholar.name, scholar.path]));
const scholars = scholarData.scholars.map((scholar) => {
  const path = pathOf.get(scholar.name);
  if (!path) throw new Error(`index: ${scholar.name} has no author page in footer-scholars.json.`);
  return { ...scholar, path };
});

// The line, split where its two clauses meet, so each can hold one row. Rebuilt and compared, so the text can't change.
const CLAUSE_END = 4;
if (line.words[CLAUSE_END].arabic !== 'أَرَهُ') throw new Error('index: the first clause no longer ends on أَرَهُ.');
const clauses = [line.words.slice(0, CLAUSE_END + 1), line.words.slice(CLAUSE_END + 1)].map((words) => words.map((word) => word.arabic).join(' '));
if (clauses.join(' ') !== line.arabic) throw new Error('index: the clauses do not rebuild the stored sentence.');

// The three chapters. Every title and note is ledger wording (PRODUCT.md), each over the screen that shows it.
const read = [
  { title: 'English above every Arabic line.', note: 'The English is machine-translated.', screen: 'read', focus: 'pair' },
  { title: 'Colour shows how multi-part words are built.', screen: 'read', focus: 'colour', zoom: true },
  { title: 'One tap gives you the meaning, a grammar note and audio.', screen: 'tap', arrive: 'sheet', ring: { on: 'word', before: true }, focus: 'card' },
  { title: 'Add the words you don’t know. Practise them with spaced repetition.', screen: 'tap', ring: { on: 'add' }, focus: 'add' },
] as const;

const remember = [
  { title: 'Hear the Arabic, then say what it means in English.', note: 'The app grades your answer.', screen: 'speak', focus: 'review', ring: { on: 'speak' } },
  { title: 'Words return when your predicted recall falls to 90%.', note: 'The numbers shown are from an example account.', screen: 'horizon', arrive: 'push', focus: 'horizon' },
] as const;

const listen = [
  { title: 'Arabic audio on every word and every line.', screen: 'player', focus: 'playing' },
  { title: 'Every text plays English first, then Arabic, or Arabic only.', screen: 'player', focus: 'player' },
] as const;
---

<Base>
  <main>
    <div class="hero-wrap">
      <section class="hero" id="top">
        <picture class="hero-photo">
          <source media="(max-width: 56.24rem)" type="image/avif" srcset="/hero-tall.avif" />
          <source media="(max-width: 56.24rem)" type="image/webp" srcset="/hero-tall.webp" />
          <source type="image/avif" srcset="/hero-wide.avif" />
          <img src="/hero-wide.webp" width="1672" height="941" alt="A man seen from behind, small in a dark room, reading a book at a table by a window at dusk." fetchpriority="high" />
        </picture>
        <div class="hero-shade"></div>
        <header class="topbar">
          <a class="brand" href="/" aria-label="OpenArabic">
            <Logo size={24} />
            <span>OpenArabic</span>
          </a>
        </header>
        <div class="hero-words">
          <h1 aria-label="Read the classics in Arabic."><span>Read</span> <span>the classics</span> <span>in Arabic.</span></h1>
          <p class="names"><span>Ibn al-Jawzī,</span> <span>Ibn al-Qayyim,</span> <span>an-Nawawī,</span> <span>Ibn Taymiyyah,</span> <span>al-Bukhārī,</span> <span>adh-Dhahabī.</span></p>
          <p class="lede">If you can sound out Arabic script, you can start reading classical texts.</p>
          <StoreLinks />
          <p class="offer-note">Free. No ads. No subscription. An account is needed in the app.</p>
        </div>
      </section>
    </div>

    <section class="scholars" id="scholars">
      <h2 class="reveal">Excerpts from the works of classical scholars</h2>
      <ul class="scholar-list">
        {
          scholars.map((scholar) => (
            <li class="scholar reveal">
              <h3><a href={scholar.path}>{scholar.name}</a></h3>
              <div class="scholar-works">
                <p data-stored>{scholar.works.slice(0, 2).join(', ')}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="turn" id="turn">
      <h2 class="turn-words reveal">You finished the course. Then you opened a real book.</h2>
      <p class="turn-line reveal" lang="ar" dir="rtl">{clauses.map((clause, index) => <>{index > 0 && ' '}<span class="clause">{clause}</span></>)}</p>
      <p class="turn-source reveal">{line.scholar}, {line.work}</p>
    </section>

    <StillPair
      class="problem"
      first={{ name: 'stuck', alt: 'A man seen from behind at a small table at night, his head in his hand, with books left open in front of him.' }}
      then={{ name: 'turn', alt: 'The same man at the same table, sitting up now, his phone in his hands and the dictionary shut beside the open book.' }}
    >
      <Fragment slot="first">
        <h2 class="problem-big">You can sound it out.<br />You can’t read it.</h2>
        <p class="problem-small">Every word is a trip to the dictionary.</p>
      </Fragment>
      <Fragment slot="then">
        <p class="bridge">In the app, the meaning is one tap away.</p>
      </Fragment>
    </StillPair>

    <Stage id="read" chapter="Read" stops={read} />

    <Still name="remember" alt="The same man the next morning, standing by the window in grey daylight with his phone in his hand.">
      <p class="still-line reveal">You choose 10, 20 or 30 new words a day.</p>
    </Still>

    <Stage id="remember" chapter="Remember" stops={remember} />

    <Still name="listen" alt="A man seen from behind, small on a wet street at dusk, wearing earphones.">
      <p class="still-line reveal">Play a text on the way home.</p>
      <div class="still-audio reveal">
        <audio controls preload="metadata" src={textAudio} aria-label="This text read aloud in Arabic"></audio>
        <p class="turn-source"><a href="/read/a-path-to-mercy-412">A Path to Mercy</a>. Ibn al-Jawzī, Ṣayd al-Khāṭir</p>
        <p class="still-note">The audio uses AI voices.</p>
      </div>
    </Still>

    <Stage id="listen" chapter="Listen" stops={listen} />

    <section class="payoff lift" id="payoff">
      <input class="lift-input vh" id="lift" type="checkbox" aria-label="Hide the English and read it" />
      <h2 class="payoff-title"><span class="ask">Try it. Tap a word you don’t know.</span> <span class="read">Now read it.</span></h2>
      <p class="payoff-english" lang="en">{line.english}</p>
      <label class="lift-control" for="lift" aria-hidden="true"><span class="take">Hide the English and read it</span> <span class="bring">Show the English</span></label>
      <TappableLine prefix="w" clauseEnd={CLAUSE_END} />
      <p class="turn-source">{line.scholar}, {line.work}</p>
      <p class="payoff-note">In the app, the English stays above the line.</p>
      <StoreLinks from="try" />
    </section>

    <section class="library" id="library">
      <h2 class="reveal">Pick a text. Read it now.</h2>
      <p class="library-quote reveal" data-stored>{line.english}</p>
      <h3 class="start-title reveal">Start with an easier text</h3>
      <ul class="start-list reveal">
        {
          startPath.articles.map((article) => (
            <li class="start-card">
              <a href={articlePath(article)}>
                <span class="start-card-title" data-stored>{article.title}</span>
                <span class="start-card-meta"><span>{article.scholar}</span> <span class="level">Easier</span></span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="library-lede reveal">Creed, fiqh, sīrah, ḥadīth, tafsīr. Sorted by difficulty. Most texts are advanced; some are easier.</p>
      <ArticleWall />
    </section>

    <Still name="close" alt="A closed book and a phone on a small table under a window, in the first light before dawn." class="closing">
      <h2 class="reveal">Free. No ads. No subscription.</h2>
      <div class="closing-offer reveal">
        <StoreLinks from="close" />
        <div class="qr-plate"><StoreQr /></div>
      </div>
      <p class="offer-note reveal">An account is needed in the app. Free as ṣadaqah jāriyah.</p>
    </Still>
  </main>
</Base>

<script>
  import '../scripts/home';
</script>
