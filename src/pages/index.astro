---
import Base from '../layouts/Base.astro';
import Screen from '../components/Screen.astro';
import Stage from '../components/Stage.astro';
import Still from '../components/Still.astro';
import ArticleWall from '../components/ArticleWall.astro';
import TappableLine from '../components/TappableLine.astro';
import StoreQr from '../components/StoreQr.astro';
import line from '../data/story-line.json';
// A whole text as the app plays it, English first, then Arabic: article 412, its stored audio_url_bilingual, copied so the player's length costs no third-party request.
import textAudio from '../assets/story/text-412-bilingual.mp3?url';
import StoreLinks from '../components/StoreLinks.astro';
import scholarData from '../data/scholars.json';
import '../styles/story.css';
import '../styles/home.css';
import readAvif from '../assets/story/ios-01-read.avif?url';
import readWebp from '../assets/story/ios-01-read.webp?url';
import tapAvif from '../assets/story/ios-02-tap-word.avif?url';
import tapWebp from '../assets/story/ios-02-tap-word.webp?url';
import listenAvif from '../assets/story/ios-04-listen.avif?url';
import listenWebp from '../assets/story/ios-04-listen.webp?url';
import audioAvif from '../assets/story/audio.avif?url';
import audioWebp from '../assets/story/audio.webp?url';
import speakAvif from '../assets/story/ios-05-speak.avif?url';
import speakWebp from '../assets/story/ios-05-speak.webp?url';
import horizonAvif from '../assets/story/horizon.avif?url';
import horizonWebp from '../assets/story/horizon.webp?url';
import wordsAvif from '../assets/story/ios-07-vocabulary.avif?url';
import wordsWebp from '../assets/story/ios-07-vocabulary.webp?url';

const readAlt = 'The app’s reader: an English line above each classical Arabic line, with parts of the words in colour.';
const tapAlt = 'The app’s sheet for the word كِتَاب: book, an audio button, and the root it comes from.';

const listenAlt = 'The app’s playlist of texts, each with its scholar and length, and a Play all button.';
const audioAlt = 'The app’s reader with its player open along the bottom, playing a text aloud.';
const speakAlt = 'The app’s voice review: one Arabic word, a sound button, and the buttons Show answer and Speak to answer.';
const horizonAlt = 'The app’s memory horizon: how many practised words hold for days, weeks and months.';
const wordsAlt = 'The app’s list of your words, each with its meaning and a bar for how strong it is.';

const readStops = [
  { title: 'English above every Arabic line.', note: 'The English is machine-translated.' },
  { title: 'Colour shows how multi-part words are built.' },
  { title: 'One tap gives you the meaning, a grammar note and audio.' },
  { title: 'For most words, see the root and other words built on it.' },
];

const listenStops = [
  { title: 'Arabic audio on every word and every line.', note: 'The audio uses AI voices.' },
  { title: 'Every text plays English first, then Arabic, or Arabic only.' },
];

const rememberStops = [
  { title: 'Add the words you don’t know. Practice them with spaced repetition.', note: 'Tap for the meaning. Long-press to save it.' },
  { title: 'You answer out loud before the app shows the meaning.', note: 'Hear the Arabic, then say what it means in English. The app grades your answer.' },
  { title: 'Words return when your predicted recall falls to 90%.', note: 'You choose 10, 20 or 30 new words a day. New words pause by themselves when your recall drops.' },
  { title: 'Every word you add stays in one list, with how strong it is.' },
];
---

<Base>
  <main>
    <div class="hero-wrap">
      <section class="hero" id="top">
        <picture class="hero-photo">
          <source media="(max-width: 56.24rem)" type="image/avif" srcset="/hero-tall.avif" />
          <source media="(max-width: 56.24rem)" type="image/webp" srcset="/hero-tall.webp" />
          <source type="image/avif" srcset="/hero-wide.avif" />
          <img src="/hero-wide.webp" width="1672" height="941" alt="A man seen from behind, small in a dark room, reading a book at a table by a window at dusk." fetchpriority="high" />
        </picture>
        <div class="hero-shade"></div>
        <header class="topbar">
          <a class="brand" href="/" aria-label="OpenArabic">
            <svg viewBox="0 0 1000 1000" width="24" height="24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M0 500a500 500 0 1 1 1000 0a500 500 0 1 1-1000 0ZM106.9 500a393.1 393.1 0 1 0 786.2 0a393.1 393.1 0 1 0-786.2 0Z" /></svg>
            <span>OpenArabic</span>
          </a>
        </header>
        <div class="hero-words">
          <h1 aria-label="Read the classics in Arabic."><span>Read</span> <span>the classics</span> <span>in Arabic.</span></h1>
          <p class="names"><span>Ibn al-Jawzi,</span> <span>Ibn al-Qayyim,</span> <span>an-Nawawi,</span> <span>Ibn Taymiyyah,</span> <span>al-Bukhari,</span> <span>adh-Dhahabi.</span></p>
          <StoreLinks />
          <p class="lede">If you can sound out Arabic script, you can start reading classical texts.</p>
          <p class="offer-note">Free. No ads. No subscription. An account is needed in the app.</p>
        </div>
      </section>
    </div>

    <section class="scholars" id="scholars">
      <h2 class="reveal">Excerpts from classical works by six scholars</h2>
      <ul class="scholar-list">
        {
          scholarData.scholars.map((scholar) => (
            <li class="scholar reveal">
              <h3>{scholar.name}</h3>
              <div class="scholar-works">
                <p>{scholar.works.join(', ')}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="turn" id="turn">
      <h2 class="turn-words reveal">You finished the course. Then you opened a real book.</h2>
      <p class="turn-line reveal" lang="ar" dir="rtl">{line.arabic}</p>
      <p class="turn-source reveal">{line.scholar}, {line.work}</p>
    </section>

    <Stage id="read" marker="Read" stops={readStops}>
      <div class="zoomer">
        <Screen avif={readAvif} webp={readWebp} alt={readAlt} />
        <span class="tap only-played" aria-hidden="true"></span>
      </div>
      <Screen avif={tapAvif} webp={tapWebp} alt="" class="sheet-dim only-played" />
      <Screen avif={tapAvif} webp={tapWebp} alt={tapAlt} class="sheet" />
    </Stage>

    <Still name="listen" alt="A man seen from behind, small on a wet street at dusk, wearing earphones.">
      <p class="still-line reveal">Play a text on the way home.</p>
      <div class="still-audio reveal">
        <audio controls preload="metadata" src={textAudio} aria-label="A Path to Mercy, read aloud, English first, then Arabic"></audio>
        <p class="turn-source"><a href="/read/a-path-to-mercy-412">A Path to Mercy</a>. Ibn al-Jawzi, Ṣayd al-Khāṭir</p>
      </div>
    </Still>

    <Stage id="listen" marker="Listen" stops={listenStops}>
      <Screen avif={listenAvif} webp={listenWebp} alt={listenAlt} />
      <Screen avif={audioAvif} webp={audioWebp} alt={audioAlt} class="audio" />
    </Stage>

    <Stage id="remember" marker="Remember" stops={rememberStops} caption="The numbers shown are from an example account.">
      <Screen avif={tapAvif} webp={tapWebp} alt="" class="only-played" />
      <span class="add only-played" aria-hidden="true"></span>
      <Screen avif={speakAvif} webp={speakWebp} alt={speakAlt} class="speak" />
      <span class="spoken only-played" aria-hidden="true"></span>
      <Screen avif={horizonAvif} webp={horizonWebp} alt={horizonAlt} class="memory" />
      <Screen avif={wordsAvif} webp={wordsWebp} alt={wordsAlt} class="word-list" />
    </Stage>

    <section class="payoff lift" id="payoff">
      <input class="lift-input vh" id="lift" type="checkbox" aria-label="Take the English away" />
      <h2 class="payoff-title">Tap a word.</h2>
      <p class="payoff-english" lang="en">{line.english}</p>
      <TappableLine prefix="w" />
      <p class="turn-source">{line.scholar}, {line.work}</p>
      <label class="lift-control" for="lift" aria-hidden="true"><span class="take">Take the English away</span> <span class="bring">Bring the English back</span></label>
    </section>

    <section class="library" id="library">
      <h2 class="reveal">Creed, fiqh, sīrah, ḥadīth, tafsīr.</h2>
      <p class="library-lede reveal">Sorted by difficulty. Most texts are advanced; some are easier.</p>
      <ArticleWall />
    </section>

    <Still name="close" alt="A closed book and a phone on a small table under a window, in the first light before dawn." class="closing">
      <h2 class="reveal">Free. No ads. No subscription.</h2>
      <div class="closing-offer reveal">
        <StoreLinks />
        <div class="qr-plate"><StoreQr /></div>
      </div>
      <p class="offer-note reveal">In the app, the English stays above the line. An account is needed in the app. Free as sadaqah jariyah.</p>
    </Still>
  </main>
</Base>

<script>
  import '../scripts/home';
</script>
