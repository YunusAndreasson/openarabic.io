---
import Base from '../layouts/Base.astro';
import StoreLinks from '../components/StoreLinks.astro';
import TappableLine from '../components/TappableLine.astro';
import line from '../data/story-line.json';
import '../styles/story.css';
import captureReader from '../assets/story/01-reader-classical-line.webp?url';
import captureAudio from '../assets/story/03-audio-playing.webp?url';
import captureReview from '../assets/story/07-voice-review-listening.webp?url';
import captureHorizon from '../assets/story/05-memory-horizon-breakdown.webp?url';

// One job per screen: one line, one phone. Stand-in captures until the new set lands.
const screens = [
  { word: 'Read', line: 'Read the Arabic itself, with English line by line.', src: captureReader, alt: 'The app’s reader, with English above each classical Arabic line.' },
  { word: 'Listen', line: 'Arabic audio on every word and every line.', src: captureAudio, alt: 'The app playing a text aloud.' },
  { word: 'Speak', line: 'You answer out loud before the app shows the meaning.', src: captureReview, alt: 'The app’s voice review, listening for your answer to one Arabic word.' },
  { word: 'Remember', line: 'Words return when your predicted recall falls to 90%.', src: captureHorizon, alt: 'The app’s memory horizon, showing how long practised words hold.' },
];
---

<Base>
  <main>
    <section class="hero" id="top">
      <div class="hero-scene" aria-hidden="true"></div>
      <header class="topbar">
        <a class="brand" href="/" aria-label="OpenArabic">
          <svg viewBox="0 0 1000 1000" width="28" height="28" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M0 500a500 500 0 1 1 1000 0a500 500 0 1 1-1000 0ZM106.9 500a393.1 393.1 0 1 0 786.2 0a393.1 393.1 0 1 0-786.2 0Z" /></svg>
          <span>OpenArabic</span>
        </a>{' '}
        <a class="get" href="/download-app?from=home">Get the app</a>
      </header>
      <div class="hero-copy">
        <h1><span class="draft">Read the classics in Arabic.</span></h1>
        <p class="lede">If you can sound out Arabic script, you can start reading classical texts.</p>
        <StoreLinks />
      </div>
    </section>

    {
      screens.slice(0, 1).map((screen) => (
        <section class="screen">
          <div class="head"><h2><span class="draft">{screen.word}</span></h2><p>{screen.line}</p></div>
          <img class="phone" src={screen.src} width="720" height="1600" decoding="async" loading="lazy" alt={screen.alt} />
        </section>
      ))
    }

    <section class="screen" id="try">
      <div class="head">
        <h2><span class="draft">Tap</span></h2>
        <p>One tap gives you the meaning, a grammar note and audio.</p>
        <p class="try-hint"><span class="draft">Try it. Tap a word.</span></p>
      </div>
      <div class="phone live">
        <p class="live-en" lang="en">{line.english}</p>
        <TappableLine prefix="w" />
        <p class="live-attr">{line.scholar}, {line.work}</p>
      </div>
    </section>

    {
      screens.slice(1).map((screen) => (
        <section class="screen">
          <div class="head"><h2><span class="draft">{screen.word}</span></h2><p>{screen.line}</p></div>
          <img class="phone" src={screen.src} width="720" height="1600" decoding="async" loading="lazy" alt={screen.alt} />
        </section>
      ))
    }

    <section class="screen shelf">
      <div class="head"><h2><span class="draft">The library</span></h2><p>Excerpts from 22 classical works by six scholars</p></div>
      <ul class="scholars">
        <li>Ibn al-Jawzi</li>
        <li>Ibn al-Qayyim</li>
        <li>an-Nawawi</li>
        <li>Ibn Taymiyyah</li>
        <li>al-Bukhari</li>
        <li>adh-Dhahabi</li>
      </ul>
    </section>

    <section class="closing">
      <div class="hero-scene" aria-hidden="true"></div>
      <div class="closing-copy">
        <h2>Free. No ads. No subscription.</h2>
        <StoreLinks />
        <p class="note">An account is needed in the app. <span class="draft">The audio uses AI voices. The English is machine-translated.</span></p>
      </div>
    </section>
  </main>
</Base>
