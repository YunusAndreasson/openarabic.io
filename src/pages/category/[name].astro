---
import type { GetStaticPaths } from 'astro';
import Content from '../../layouts/Content.astro';
import ArticleList from '../../components/ArticleList.astro';
import Offer from '../../components/Offer.astro';
import { site } from '../../lib/snapshot.mjs';
import { absolute, itemList } from '../../lib/site.mjs';
import { categoryLabel, categoryPath, difficultyLine, shownName } from '../../lib/words.mjs';

export const getStaticPaths = (() => site().categoriesWithTexts().map((category) => ({ params: { name: category.name }, props: { category } }))) satisfies GetStaticPaths;

const { category } = Astro.props;
const label = categoryLabel(category.name);
const articles = site().byDifficulty(site().articlesIn(category.id));
const path = categoryPath(category.name);
const jsonLd = [
  { '@type': 'CollectionPage', name: label, url: absolute(path), inLanguage: 'en' },
  itemList(articles),
];
---

<Content title={`${label}: classical Arabic texts | OpenArabic`} description={`Excerpts from classical works on ${label}, in Arabic with English under every line.`} canonical={path} jsonLd={jsonLd}>
  <h1>{label}</h1>
  <p class="lead">{difficultyLine(articles)}</p>
  <ArticleList articles={articles} authorOf={(article) => shownName(site().author(article.author_id).name)} />
  <Offer from="read" screen="read" />
</Content>
