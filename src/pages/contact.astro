---
// D10: a plain link, no form and no third party. The maker's GitHub is the one personal link.
import Content from '../layouts/Content.astro';
import { SOCIAL } from '../lib/site.mjs';
---

<Content title="Contact | OpenArabic" description="How to reach OpenArabic." canonical="/contact">
  <div class="legal">
    <h1>Contact</h1>
    <p>Write to <a href="mailto:contact@openarabic.io">contact@openarabic.io</a>.</p>
    <p>Also on <a href={SOCIAL.x} rel="noopener">X</a>, <a href={SOCIAL.instagram} rel="noopener">Instagram</a> and <a href={SOCIAL.facebook} rel="noopener">Facebook</a>.</p>
    <p>OpenArabic by <a href="https://github.com/YunusAndreasson" rel="me noopener noreferrer">Yunus Andréasson</a>.</p>
  </div>
</Content>
