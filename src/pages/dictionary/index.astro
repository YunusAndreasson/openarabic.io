---
import Content from '../../layouts/Content.astro';
import Entries from '../../components/Entries.astro';
import Offer from '../../components/Offer.astro';
import SearchForm from '../../components/SearchForm.astro';
import LetterNav from '../../components/LetterNav.astro';
import { site } from '../../lib/snapshot.mjs';
import { absolute, breadcrumbs } from '../../lib/site.mjs';

const jsonLd = [
  { '@type': 'CollectionPage', name: 'Arabic Dictionary', url: absolute('/dictionary'), inLanguage: 'en', isPartOf: { '@id': absolute('/#website') } },
  breadcrumbs(['Dictionary', '/dictionary']),
];
---

<Content title="Arabic Dictionary: Words with Audio and Example Sentences | OpenArabic" description="Arabic words with their English meanings, audio and example sentences from classical texts." canonical="/dictionary" jsonLd={jsonLd}>
  <h1>Arabic dictionary</h1>
  <p class="lead">Arabic words with their meanings, audio and example sentences from classical texts.</p>
  <SearchForm />
  <section><h2>Browse by letter</h2><LetterNav /></section>
  <section><h2>Most used words</h2><Entries entries={site().mostUsed(300)} /></section>
  <Offer from="word" />
</Content>
