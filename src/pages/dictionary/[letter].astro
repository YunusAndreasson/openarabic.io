---
import Content from '../../layouts/Content.astro';
import Entries from '../../components/Entries.astro';
import Offer from '../../components/Offer.astro';
import LetterNav from '../../components/LetterNav.astro';
import SearchForm from '../../components/SearchForm.astro';
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import { site } from '../../lib/snapshot.mjs';
import { absolute, breadcrumbs } from '../../lib/site.mjs';
import { bucketLabel } from '../../lib/words.mjs';

export const getStaticPaths = (() => site().letters().map((letter) => ({ params: { letter } }))) satisfies GetStaticPaths;

const { letter } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const label = bucketLabel(letter);
const startsWith = letter === '0-9' ? 'a number' : letter === 'other' ? 'another character' : label;
const entries = site().entriesIn(letter);
const path = `/dictionary/${letter}`;
const jsonLd = [
  { '@type': 'CollectionPage', name: `Arabic words by meaning: ${label}`, url: absolute(path), inLanguage: 'en', isPartOf: { '@type': 'CollectionPage', name: 'Arabic Dictionary', url: absolute('/dictionary') } },
  breadcrumbs(['Dictionary', '/dictionary'], [label, path]),
];
---

<Content title={`Arabic words by meaning: ${label} | OpenArabic Dictionary`} description={`Arabic words whose English meaning starts with ${startsWith}, each with audio and example sentences from classical texts.`} canonical={path} jsonLd={jsonLd} crumbs={[{ name: 'Dictionary', path: '/dictionary' }, { name: label }]}>
  <h1>Arabic words by meaning: {label}</h1>
  <p class="lead">{entries.length.toLocaleString('en')} Arabic {entries.length === 1 ? 'word' : 'words'} whose English meaning starts with {startsWith}.</p>
  <SearchForm />
  <LetterNav active={letter} />
  <section><Entries entries={entries} /></section>
  <Offer from="word" screen="tap" />
</Content>
