---
import Content from '../../layouts/Content.astro';
import Entries from '../../components/Entries.astro';
import Offer from '../../components/Offer.astro';
import LetterNav from '../../components/LetterNav.astro';
import SearchForm from '../../components/SearchForm.astro';
import { site } from '../../lib/snapshot.mjs';
import { bucketLabel, BUCKETS } from '../../lib/words.mjs';

export function getStaticPaths() {
  const present = site().buckets();
  return BUCKETS.filter((bucket) => present.has(bucket)).map((letter) => ({ params: { letter } }));
}

const { letter } = Astro.params;
const label = bucketLabel(letter);
const entries = site().entriesIn(letter);
const SITE = 'https://openarabic.io';
const path = `/dictionary/${letter}`;
const jsonLd = [
  { '@type': 'CollectionPage', name: `Arabic words starting with ${label}`, url: `${SITE}${path}`, inLanguage: 'en', isPartOf: { '@type': 'CollectionPage', name: 'Arabic Dictionary', url: `${SITE}/dictionary` } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: 'Dictionary', item: `${SITE}/dictionary` }, { '@type': 'ListItem', position: 3, name: label, item: `${SITE}${path}` }] },
];
---

<Content title={`Arabic words starting with ${label} | OpenArabic Dictionary`} description={`Arabic words whose English meaning starts with ${label}, each with audio and example sentences from classical texts.`} canonical={path} jsonLd={jsonLd} crumbs={[{ name: 'Dictionary', path: '/dictionary' }, { name: label }]}>
  <h1>Arabic words starting with {label}</h1>
  <p class="lead">{entries.length.toLocaleString('en')} words whose English meaning starts with {label}.</p>
  <SearchForm />
  <LetterNav active={letter} />
  <section><Entries entries={entries} /></section>
  <Offer from="word" />
</Content>
